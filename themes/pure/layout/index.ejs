<%
  /* 首页：CV 单页（中英双构建共用，文案走 languages）。 */
  var isEn = config.language === 'en';

  var skills = [
    { zh: 'HTML / CSS',   en: 'HTML / CSS' },
    { zh: 'JavaScript',   en: 'JavaScript' },
    { zh: 'Vue',          en: 'Vue' },
    { zh: 'React',        en: 'React' },
    { zh: 'Node.js',      en: 'Node.js' },
    { zh: 'Java / Spring',en: 'Java / Spring' },
    { zh: 'Git',          en: 'Git' },
    { zh: 'Python',       en: 'Python' },
    { zh: 'UI 设计',      en: 'UI Design' }
  ];

  var experiences = [
    { title: 'home.exp1.title', date: 'home.exp1.date', desc: 'home.exp1.desc' },
    { title: 'home.exp2.title', date: 'home.exp2.date', desc: 'home.exp2.desc' }
  ];

  var recent = site.posts.sort('-date').toArray().slice(0, 2);
%>

<div class="cv">

  <!-- Hero -->
  <header class="cv-hero">
    <h1 class="cv-name"><%= __('home.name') %></h1>
    <p class="cv-subtitle"><%= __('home.subtitle') %></p>
    <p class="cv-tagline"><%= __('home.tagline') %></p>
    <p class="cv-contact">
      <a href="mailto:3021809270@qq.com"><%= __('home.contact_label') %></a>
      <a href="https://github.com/RainbowJier" target="_blank" rel="noopener">GitHub</a>
    </p>
  </header>

  <!-- 关于 -->
  <section class="cv-section" id="about">
    <h2 class="cv-section-title">
      <span class="en"><%= __('home.about_en') %></span>
      <span class="zh"><%= __('home.about_zh') %></span>
    </h2>
    <div class="cv-prose"><%= __('home.about_text') %></div>
  </section>

  <!-- 技能 -->
  <section class="cv-section" id="skills">
    <h2 class="cv-section-title">
      <span class="en"><%= __('home.skills_en') %></span>
      <span class="zh"><%= __('home.skills_zh') %></span>
    </h2>
    <div class="cv-skills">
      <% skills.forEach(function (s) { %>
        <span class="cv-skill"><%= isEn ? s.en : s.zh %></span>
      <% }); %>
    </div>
  </section>

  <!-- 经历 -->
  <section class="cv-section" id="experience">
    <h2 class="cv-section-title">
      <span class="en"><%= __('home.experience_en') %></span>
      <span class="zh"><%= __('home.experience_zh') %></span>
    </h2>
    <ul class="cv-timeline">
      <% experiences.forEach(function (e) { %>
        <li class="cv-timeline-item">
          <h3 class="cv-timeline-title"><%= __(e.title) %></h3>
          <div class="cv-date"><%= __(e.date) %></div>
          <p class="cv-timeline-desc"><%= __(e.desc) %></p>
        </li>
      <% }); %>
    </ul>
  </section>

  <!-- 最新文章 -->
  <section class="cv-section" id="posts">
    <h2 class="cv-section-title">
      <span class="en"><%= __('home.posts_en') %></span>
      <span class="zh"><%= __('home.posts_zh') %></span>
    </h2>
    <% if (recent.length) { %>
      <div class="post-list">
        <% recent.forEach(function (post) { %>
          <%- partial('_partial/post-card', { post: post }) %>
        <% }); %>
      </div>
    <% } %>
    <p class="cv-more"><a class="link-more" href="<%- url_for('/archives/') %>"><%= __('home.posts_more') %></a></p>
  </section>

  <!-- 精选作品 -->
  <section class="cv-section" id="projects">
    <h2 class="cv-section-title">
      <span class="en"><%= __('home.projects_en') %></span>
      <span class="zh"><%= __('home.projects_zh') %></span>
    </h2>
    <div class="cv-prose"><%= __('home.projects_desc') %></div>
    <p class="cv-more"><a class="link-more" href="<%- url_for('/projects/') %>"><%= __('home.projects_more') %></a></p>
  </section>

</div>
