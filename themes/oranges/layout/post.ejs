<!-- 文章详情页，展示文章具体内容，url形式：https://yoursite/文章标题/ -->
<!-- 同时承载标签、分类和关于页面，具体展示取决于 page.type -->

<% if (theme.codeBlock && theme.codeBlock.copy && theme.codeBlock.copy.enable){ %>
  <%- partial('_partial/clipboard') %>
<% } %>

<% if (page.type === "tags") { %>
  <!-- 标签页 url形式：https://yoursite/tags/ -->
  <div class="container tag-index">
    <div>
      <%- list_tags({ class: "tag" }) %>
    </div>
  </div>
  <% } %>

  <% if (page.type === "categories") { %>
  <!-- 分类页 url形式：https://yoursite/categories/ -->
  <div class="container category-index">
    <div>
      <%- list_categories({orderby: "length", order: -1}) %>
    </div>
  </div>
  <% } %>

  <% if(page.type === "about") { %>
  <!-- 关于页 url形式：https://yoursite/about/ -->
    <div class="container about-index">
      <div class="markdown-body">
        <%- page.content %>
      </div>
    </div>
  <% } %>

  <% if(page.type === "projects") { %>
  <!-- 项目经历页 url形式：https://yoursite/projects/，列表数据来自分类「项目经历」下的文章 -->
    <%
      var projCat = site.categories.findOne({ name: '项目经历' });
      var projList = projCat ? projCat.posts.sort('date', -1).data : [];
    %>
    <div class="container project-index">
      <% if (page.content && page.content.trim()) { %>
      <div class="markdown-body project-intro">
        <%- page.content %>
      </div>
      <% } %>
      <% if (projList.length) { %>
      <div class="project-list">
        <% projList.forEach(function(item) { %>
          <a class="project-item" href="<%- url_for(item.path) %>" title="<%- item.title %>">
            <div class="project-item-head">
              <span class="project-item-name"><%- item.title %></span>
              <span class="project-item-period"><%- item.period || item.date.format('YYYY.MM') %></span>
            </div>
            <% if (item.role) { %>
            <div class="project-item-role"><%- item.role %></div>
            <% } %>
            <% if (item.description) { %>
            <div class="project-item-desc"><%- item.description %></div>
            <% } %>
            <% if (item.stack && item.stack.length) { %>
            <div class="project-item-stack">
              <% item.stack.forEach(function(s) { %>
                <span class="skill-chip"><%- s %></span>
              <% }) %>
            </div>
            <% } %>
          </a>
        <% }) %>
      </div>
      <% } %>
    </div>
  <% } %>

  <% if(page.type === "plan") { %>
  <!-- 学习计划页 url形式：https://yoursite/plan/，计划数据来自本页 front matter 的 plans 列表 -->
    <%
      var planGroups = [
        { key: 'doing', label: '进行中' },
        { key: 'planned', label: '计划中' },
        { key: 'done', label: '已完成' }
      ];
      var planItems = page.plans || [];
    %>
    <div class="container plan-index">
      <% if (page.content && page.content.trim()) { %>
      <div class="markdown-body plan-intro">
        <%- page.content %>
      </div>
      <% } %>
      <% planGroups.forEach(function(group) {
           var items = planItems.filter(function(p) { return p.status === group.key; });
           if (!items.length) return;
      %>
      <section class="plan-group">
        <h2 class="plan-group-title"><%- group.label %><span class="plan-group-count"><%- items.length %></span></h2>
        <div class="plan-list">
          <% items.forEach(function(p) {
               var seg = String(p.progress || '').split('/');
               var doneCount = parseInt(seg[0], 10);
               var totalCount = parseInt(seg[1], 10);
               var hasBar = !isNaN(doneCount) && !isNaN(totalCount) && totalCount > 0;
               var percent = hasBar ? Math.min(100, Math.round(doneCount / totalCount * 100)) : 0;
          %>
          <% if (p.link) { %><a class="plan-item" href="<%- url_for(p.link) %>" title="<%- p.name %>"><% } else { %><div class="plan-item"><% } %>
            <div class="plan-item-head">
              <span class="plan-item-name"><%- p.name %></span>
              <span class="plan-item-progress"><%- p.progress || (p.status === 'done' ? '已完成' : '未开始') %></span>
            </div>
            <% if (hasBar && p.status !== 'done') { %>
            <div class="plan-progress" role="progressbar" aria-valuenow="<%- percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="<%- p.name %> 进度">
              <div class="plan-progress-fill" style="width: <%- percent %>%"></div>
            </div>
            <% } %>
            <% if (p.note) { %>
            <div class="plan-item-note"><%- p.note %></div>
            <% } %>
          <% if (p.link) { %></a><% } else { %></div><% } %>
          <% }) %>
        </div>
      </section>
      <% }) %>
    </div>
  <% } %>

  <% if (!page.type) { %>
  <!-- 文章内容页 url形式：https://yoursite/文章标题/ -->
  <div class="container post-details" id="post-details">
    <div class="post-content">
      <div class="post-title"><%- page.title %></div>
      <div class="post-attach">
        <span class="post-pubtime">
          <i class="iconfont icon-updatetime mr-10" title="<%= __('updateTime') %>"></i>
          <%- page.updated.format("YYYY-MM-DD HH:mm:ss") %>
        </span>
        <% for(item of theme.navbar) {
          if (item.key === 'tags' && item.enable) {
            if(page.tags && page.tags.length > 0) { %>
              <span class="post-tags">
                <i class="iconfont icon-tags mr-10" title="<%= __('tags') %>"></i>
                <% for(let item of page.tags.data) { %>
                <span class="span--tag mr-8">
                  <a href="<%= url_for(item.path)%>" title="<%- item.name %>">
                    #<%- item.name %>
                  </a>
                </span>
                <% } %>
              </span>
          <% }
          }
          if (item.key === 'categories' && item.enable) {
            if(page.categories && page.categories.length > 0) { %>
              <span class="post-categories">
                <i class="iconfont icon-bookmark" title="<%= __('categories') %>"></i>
                <% for(let item of page.categories.data){ %>
                <span class="span--category">
                  <a href="<%= url_for(item.path)%>" title="<%- item.name %>">
                    <b>#</b> <%- item.name %>
                  </a>
                </span>
                <% } %>
              </span>
          <% }
          }
        } %>
      </div>
      <div class="markdown-body">
        <%- page.content %>
      </div>
      <% if(theme.prevnext.enable) { %>
        <div class="prev-or-next">
          <div class="post-foot-next">
            <% if(page.next) { %>
              <a href="<%- url_for(page.next.path) %>" target="_self">
                <i class="iconfont icon-chevronleft"></i>
                <span><%= __('prev') %></span>
              </a>
            <% } %>
          </div>
          <div class="post-attach">
            <span class="post-pubtime">
              <i class="iconfont icon-updatetime mr-10" title="<%= __('updateTime') %>"></i>
              <%- page.updated.format("YYYY-MM-DD HH:mm:ss") %>
            </span>
            <% for(item of theme.navbar) {
              if (item.key === 'tags' && item.enable) {
                if(page.tags && page.tags.length > 0) { %>
                  <span class="post-tags">
                    <i class="iconfont icon-tags mr-10" title="<%= __('tags') %>"></i>
                    <% for(let item of page.tags.data) { %>
                    <span class="span--tag mr-8">
                      <a href="<%= url_for(item.path)%>" title="<%- item.name %>">
                        #<%- item.name %>
                      </a>
                    </span>
                    <% } %>
                  </span>
              <% }
              }
              if (item.key === 'categories' && item.enable) {
                if(page.categories && page.categories.length > 0) { %>
                  <span class="post-categories">
                    <i class="iconfont icon-bookmark" title="<%= __('categories') %>"></i>
                    <% for(let item of page.categories.data){ %>
                    <span class="span--category">
                      <a href="<%= url_for(item.path)%>" title="<%- item.name %>">
                        <b>#</b> <%- item.name %>
                      </a>
                    </span>
                    <% } %>
                  </span>
              <% }
              }
            } %>
          </div>
          <div class="post-foot-prev">
            <% if(page.prev) { %>
              <a href="<%- url_for(page.prev.path) %>" target="_self">
                <span><%= __('next') %></span>
                <i class="iconfont icon-chevronright"></i>
              </a>
            <% } %>
          </div>
        </div>
      <% } %>
    </div>
    <%- partial("_partial/catalog") %>
  </div>
<% } %>
