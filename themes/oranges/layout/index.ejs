<div class="container index">
  <% if (theme.intro) { %>
  <div class="home-intro">
    <div class="home-intro-head">
      <h2 class="home-intro-name"><%- theme.intro.name %></h2>
      <p class="home-intro-role"><%- theme.intro.role %></p>
    </div>
    <% if (theme.intro.bio) { %>
    <p class="home-intro-desc"><%- theme.intro.bio %></p>
    <% } %>
    <% if (theme.intro.skills && theme.intro.skills.length) { %>
    <div class="home-intro-skills">
      <% theme.intro.skills.forEach(function(skill) { %>
        <span class="skill-chip"><%- skill %></span>
      <% }) %>
    </div>
    <% } %>
    <% if (theme.intro.profile && theme.intro.profile.length) { %>
    <div class="home-exp">
      <div class="home-exp-title"><%= __('profile') %></div>
      <div class="home-profile">
        <% theme.intro.profile.forEach(function(item) { %>
          <div class="home-profile-item">
            <span class="home-profile-label"><%- item.label %></span>
            <span class="home-profile-value"><%- item.value %></span>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
    <%
      // 按时间段起始年月升序（最早在前），与配置书写顺序无关
      var byPeriodAsc = function(a, b) {
        var parse = function(p) {
          var m = /(\d{4})\.(\d{1,2})/.exec(p || '');
          return m ? parseInt(m[1], 10) * 100 + parseInt(m[2], 10) : 0;
        };
        return parse(a.period) - parse(b.period);
      };
      var workList = (theme.intro.work || []).slice().sort(byPeriodAsc);
      var eduList = (theme.intro.education || []).slice().sort(byPeriodAsc);
      // 项目经历：自动取分类「项目经历」下的文章，按时间倒序（最新在前）
      var projCat = site.categories.findOne({ name: '项目经历' });
      var projList = projCat ? projCat.posts.sort('date', -1).data : [];
    %>
    <% if (eduList.length) { %>
    <div class="home-exp">
      <div class="home-exp-title"><%= __('education') %></div>
      <% eduList.forEach(function(item) { %>
        <div class="home-exp-item">
          <span class="home-exp-logo">
            <span class="home-exp-monogram<%- item.logo ? ' hidden' : '' %>"><%- item.short || item.name %></span>
            <% if (item.logo) { %>
              <img src="<%- url_for(item.logo) %>" alt="<%- item.short || item.name %>" loading="lazy" onerror="this.classList.add('hidden');this.previousElementSibling.classList.remove('hidden')">
            <% } %>
          </span>
          <div class="home-exp-info">
            <div class="home-exp-name"><%- item.name %></div>
            <div class="home-exp-role"><%- item.role %><% if (item.location) { %> · <%- item.location %><% } %></div>
          </div>
          <div class="home-exp-period"><%- item.period %></div>
        </div>
      <% }) %>
    </div>
    <% } %>
    <% if (workList.length) { %>
    <div class="home-exp">
      <div class="home-exp-title"><%= __('work') %></div>
      <% workList.forEach(function(item) { %>
        <div class="home-exp-item">
          <span class="home-exp-logo">
            <span class="home-exp-monogram<%- item.logo ? ' hidden' : '' %>"><%- item.short || item.name %></span>
            <% if (item.logo) { %>
              <img src="<%- url_for(item.logo) %>" alt="<%- item.short || item.name %>" loading="lazy" onerror="this.classList.add('hidden');this.previousElementSibling.classList.remove('hidden')">
            <% } %>
          </span>
          <div class="home-exp-info">
            <div class="home-exp-name"><%- item.name %></div>
            <div class="home-exp-role"><%- item.role %><% if (item.location) { %> · <%- item.location %><% } %></div>
          </div>
          <div class="home-exp-period"><%- item.period %></div>
        </div>
      <% }) %>
    </div>
    <% } %>
    <% if (projList.length) { %>
    <div class="home-exp">
      <div class="home-exp-title"><%= __('projects') %></div>
      <% projList.forEach(function(item) { %>
        <a class="home-exp-item" href="<%- url_for(item.path) %>" title="<%- item.title %>">
          <span class="home-exp-logo">
            <span class="home-exp-monogram"><%- item.title.slice(0, 1) %></span>
          </span>
          <div class="home-exp-info">
            <div class="home-exp-name"><%- item.title %></div>
            <div class="home-exp-role"><%- item.role || item.description || '' %></div>
          </div>
          <div class="home-exp-period"><%- item.period || item.date.format('YYYY.MM') %></div>
        </a>
      <% }) %>
    </div>
    <% } %>
    <% var statList = (theme.intro.stats || []).slice(); %>
    <% if (site.posts.length) { statList.push({ value: String(site.posts.length), label: __('posts_count') }); } %>
    <% if (statList.length) { %>
    <div class="home-intro-stats">
      <% statList.forEach(function(stat) { %>
        <div class="stat-item">
          <span class="stat-value"><%- stat.value %></span>
          <span class="stat-label"><%- stat.label %></span>
        </div>
      <% }) %>
    </div>
    <% } %>
    <% if (theme.postCalendar && theme.postCalendar.enable) { %>
    <%
      // 文章发布热力图：按每篇文章的发布日期统计最近一年的发布节奏（周一为一周起始），
      // 构建期内联为 SVG，数据随每次部署更新；颜色深浅 = 当天发布文章数（0-4 级）
      var PC_CELL = 10, PC_PITCH = 13, PC_X0 = 30, PC_Y0 = 16;
      var pcEnd = new Date(); pcEnd.setHours(0, 0, 0, 0);
      var pcStart = new Date(pcEnd); pcStart.setDate(pcStart.getDate() - 363);
      var pcDow = function (d) { return (d.getDay() + 6) % 7; };
      var pcFirst = new Date(pcStart); pcFirst.setDate(pcFirst.getDate() - pcDow(pcStart));
      var pcWeeks = Math.ceil((pcDow(pcStart) + 364) / 7);
      var pcKey = function (d) {
        return d.getFullYear() + '-' + ('0' + (d.getMonth() + 1)).slice(-2) + '-' + ('0' + d.getDate()).slice(-2);
      };
      var pcCounts = {};
      var pcInYear = 0;
      var pcWindowStart = pcKey(pcStart);
      var pcWindowEnd = pcKey(pcEnd);
      site.posts.forEach(function (p) {
        var key = p.date.format('YYYY-MM-DD');
        if (key >= pcWindowStart && key <= pcWindowEnd) pcInYear++;
        pcCounts[key] = (pcCounts[key] || 0) + 1;
      });
      var pcLevel = function (n) { return n >= 4 ? 4 : n; };
      var pcRects = [];
      var pcCursor = new Date(pcFirst);
      for (var w = 0; w < pcWeeks; w++) {
        for (var dow = 0; dow < 7; dow++) {
          var inWindow = pcCursor >= pcStart;
          var key = pcKey(pcCursor);
          var n = inWindow ? (pcCounts[key] || 0) : 0;
          var tip = key + ' · ' + (n ? __('calendarPostCount').replace('{n}', n) : __('calendarNoPost'));
          pcRects.push(
            '<rect class="cal-' + pcLevel(n) + '" x="' + (PC_X0 + w * PC_PITCH) + '" y="' + (PC_Y0 + dow * PC_PITCH) + '"' +
            ' width="' + PC_CELL + '" height="' + PC_CELL + '" rx="2" ry="2"' +
            ' data-date="' + key + '" data-count="' + n + '" aria-label="' + tip + '"></rect>'
          );
          pcCursor.setDate(pcCursor.getDate() + 1);
        }
      }
      // 顶部月份标签：每月第一周所在列；末尾留白不足两列时不标，避免溢出
      var pcMonthLabels = [];
      var pcLastMonth = -1;
      for (var w2 = 0; w2 < pcWeeks; w2++) {
        var topDay = new Date(pcFirst); topDay.setDate(topDay.getDate() + w2 * 7);
        if (topDay.getMonth() !== pcLastMonth) {
          pcLastMonth = topDay.getMonth();
          if (w2 <= pcWeeks - 3) {
            pcMonthLabels.push('<text x="' + (PC_X0 + w2 * PC_PITCH) + '" y="10">' + (topDay.getMonth() + 1) + '月</text>');
          }
        }
      }
      // 左侧星期标签：一 / 三 / 五
      var pcDowLabels = [];
      [[0, '一'], [2, '三'], [4, '五']].forEach(function (pair) {
        pcDowLabels.push('<text x="0" y="' + (PC_Y0 + pair[0] * PC_PITCH + 8.5) + '">' + pair[1] + '</text>');
      });
    %>
    <div class="post-calendar">
      <div class="post-calendar-scroll">
        <svg viewBox="0 0 <%= PC_X0 + pcWeeks * PC_PITCH %> <%= PC_Y0 + 7 * PC_PITCH %>" role="img" aria-label="<%= __('calendarAria') %>">
          <%- pcMonthLabels.join('') %>
          <%- pcDowLabels.join('') %>
          <%- pcRects.join('') %>
        </svg>
      </div>
      <div class="post-calendar-footer">
        <span class="post-calendar-summary"><%= __('calendarSummary').replace('{n}', pcInYear) %></span>
        <span class="post-calendar-legend"><%= __('calendarLess') %><i class="cal-0"></i><i class="cal-1"></i><i class="cal-2"></i><i class="cal-3"></i><i class="cal-4"></i><%= __('calendarMore') %></span>
      </div>
    </div>
    <%- js(['/js/postCalendar.js']) %>
    <% } %>
    <% if (theme.intro.links && theme.intro.links.length) { %>
    <div class="home-intro-links">
      <% theme.intro.links.forEach(function(link) { %>
        <a href="<%- url_for(link.path) %>" <%- /^https?:/.test(link.path) ? 'target="_blank" rel="noopener"' : '' %>><%- link.name %></a>
      <% }) %>
    </div>
    <% } %>
  </div>
  <% } %>
  <div class="post-list">
    <!-- 遍历渲染文章 -->
    <% page.posts.forEach(function(item) { %>
      <div class="post-item" title="<%- item.title %>">
        <div class="time-m-d"><%- item.date.format("YYYY-MM-DD") %></div>
        <div class="title">
          <a href="<%- url_for(item.path) %>">
            <% if(item.title !== "") { %>
              <% if (item.top) { %>
                <span><span title="<%= __('pinned') %>" class="icon iconfont icon-pin-top post-top"></span><%- item.title %></span>
              <% } else { %>
                <span><%- item.title %></span>
              <% } %>
            <% } else { %>
              <span>untitled</span>
            <% } %>
          </a>
        </div>
      </div>
    <% }) %>
  </div>
  <% if (page.total > 1) { %>
  <nav class="post-navigation">
    <% if(page.prev !== 0){ %>
      <a href="<%- url_for(page.prev_link)%>"><i class="iconfont icon-angleleft"></i></a>
    <% } %>
    <span class="page-num"><%- page.current %> / <%- page.total -%></span>
    <% if(page.next !== 0){ %>
      <a href="<%- url_for(page.next_link)%>"><i class="iconfont icon-angleright"></i></a>
    <% } %>
  </nav>
  <%- js(['/js/pagination.js']) %>
  <% } %>
</div>
