<% if (theme.search.enable) { %>
  <div class="search-icon tools-bar-item" id="search-icon">
    <a href="javascript: void(0)">
      <i class="iconfont icon-search"></i>
    </a>
  </div>

  <div class="search-overlay hidden">
    <div class="search-content" tabindex="0">
      <div class="search-title">
        <span class="search-icon-input">
          <a href="javascript: void(0)">
            <i class="iconfont icon-search"></i>
          </a>
        </span>
        <% if (theme.search.placeholder) { %>
          <input type="text" class="search-input" id="search-input" placeholder="<%- theme.search.placeholder %>">
        <% } else { %>
          <input type="text" class="search-input" id="search-input" placeholder="<%= __('search') %>">
        <% } %>
        <span class="search-close-icon" id="search-close-icon">
          <a href="javascript: void(0)">
            <i class="iconfont icon-close"></i>
          </a>
        </span>
      </div>
      <div class="search-result" id="search-result"></div>
    </div>
  </div>

  <script>
    (() => {
      const input = document.querySelector('#search-input')
      const overlay = document.querySelector('.search-overlay')
      const result = document.querySelector('#search-result')
      const searchIcon = document.querySelector('#search-icon')
      const closeIcon = document.querySelector('#search-close-icon')
      let entries = null

      const setResultMessage = (message, link) => {
        result.replaceChildren()
        const list = document.createElement('ul')
        const item = document.createElement('span')
        item.className = 'local-search-empty'
        item.textContent = message
        list.appendChild(item)
        if (link) {
          const anchor = document.createElement('a')
          anchor.href = link.href
          anchor.target = '_blank'
          anchor.rel = 'noreferrer'
          anchor.textContent = link.label
          list.appendChild(anchor)
        }
        result.appendChild(list)
      }

      const stripTags = value => {
        const node = document.createElement('div')
        node.innerHTML = value
        return node.textContent || ''
      }

      const renderResults = () => {
        const keywords = input.value.trim().toLowerCase().split(/[\s\-]+/).filter(Boolean)
        result.replaceChildren()
        if (!keywords.length) return
        const list = document.createElement('ul')
        list.className = 'search-result-list'
        let matches = 0

        entries.forEach(entry => {
          const title = (entry.title || 'Untitled').trim()
          const content = stripTags(entry.content || '').trim()
          const titleLower = title.toLowerCase()
          const contentLower = content.toLowerCase()
          if (!content || !keywords.every(keyword => titleLower.includes(keyword) || contentLower.includes(keyword))) return

          const firstOccurrence = Math.max(0, ...keywords.map(keyword => {
            const index = contentLower.indexOf(keyword)
            return index < 0 ? 0 : index
          }))
          const excerpt = content.slice(Math.max(0, firstOccurrence - 20), firstOccurrence + 80)
          const titleLink = document.createElement('a')
          titleLink.className = 'search-result-title'
          titleLink.href = entry.url
          titleLink.textContent = title

          const item = document.createElement('li')
          item.appendChild(titleLink)
          const abstract = document.createElement('p')
          abstract.className = 'search-result-abstract'
          abstract.textContent = `${excerpt}${excerpt.length < content.length ? '...' : ''}`
          item.appendChild(abstract)
          list.appendChild(item)
          matches += 1
        })

        if (matches) {
          result.appendChild(list)
        } else {
          setResultMessage('<%= __('searchNoResult') %>')
        }
      }

      const loadSearchIndex = () => {
        if (entries) return Promise.resolve()
        setResultMessage('<%= __('searchFirst') %>')
        return fetch('<%- url_for("search.xml") %>')
          .then(response => {
            if (!response.ok) {
              const error = new Error('search-index')
              error.status = response.status
              throw error
            }
            return response.text()
          })
          .then(xml => {
            const documentXml = new DOMParser().parseFromString(xml, 'application/xml')
            entries = Array.from(documentXml.querySelectorAll('entry')).map(entry => ({
              title: entry.querySelector('title')?.textContent || '',
              content: entry.querySelector('content')?.textContent || '',
              url: entry.querySelector('url')?.textContent || ''
            }))
            input.addEventListener('input', renderResults)
            renderResults()
          })
          .catch(error => {
            const message = error.status === 404 ? '<%= __('searchFilesNotfound') %>' : '<%= __('searchServiceErrors') %>'
            const link = error.status === 404 ? {
              href: 'https://github.com/zchengsite/hexo-theme-oranges#configuration',
              label: '配置说明'
            } : null
            setResultMessage(message, link)
          })
      }

      const toggleSearch = () => {
        const hidden = overlay.classList.toggle('hidden')
        document.body.classList.toggle('hidden', !hidden)
        if (!hidden) input.focus()
      }

      searchIcon.addEventListener('click', toggleSearch)
      closeIcon.addEventListener('click', toggleSearch)
      overlay.addEventListener('click', event => {
        if (event.target === overlay) toggleSearch()
      })
      input.addEventListener('keydown', event => {
        if (event.key === 'Enter') event.preventDefault()
      })
      input.addEventListener('focus', loadSearchIndex, { once: true })
    })()
  </script>
<% } %>
